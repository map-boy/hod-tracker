rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function hasEmail() { return signedIn() && 'email' in request.auth.token && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isDev() { return hasEmail() && request.auth.token.email_verified == true && myEmail() == 'techubwenge@gmail.com'; }
    function staffDoc() { return get(/databases/$(db)/documents/staffEmails/$(myEmail())); }
    function isStaff() { return isDev() || (hasEmail() && exists(/databases/$(db)/documents/staffEmails/$(myEmail()))); }
    function isHod() { return isDev() || (isStaff() && staffDoc().data.role == 'hod'); }
    function staffShape() { return request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt']); }

    match /staffEmails/{em} {
      allow get: if hasEmail() && (myEmail() == em || isStaff());
      allow list: if isHod();
      allow create: if isDev() || (isHod() && staffShape() && request.resource.data.role == 'rep' && request.resource.data.addedBy == myEmail());
      allow update: if isDev() || (isHod() && staffShape() && resource.data.role == 'rep' && request.resource.data.role == 'rep');
      allow delete: if isDev() || (isHod() && resource.data.role == 'rep');
    }

    match /classes/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['code', 'program', 'year', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isHod();
    }

    match /groups/{id} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow create: if signedIn()
        && request.resource.data.affected == 1
        && request.resource.data.status == 'submitted';
      allow update: if isHod()
        || (signedIn()
            && request.resource.data.affected == resource.data.affected + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affected', 'updatedAt', 'blocksRegistration']));
      allow delete: if isHod();
    }

    match /cases/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'classId', 'uid', 'regNo', 'name', 'phone', 'courseCode', 'issueType', 'description', 'proofUrls', 'blocksRegistration', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.regNo.size() <= 20
        && request.resource.data.phone.size() <= 20
        && request.resource.data.description.size() <= 2000;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow list: if isStaff();
      allow update: if isHod();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if isDev();
    }
  }
}
